<resources>
    <!-- Android 12+ 兜底：若个别系统仍绘制启动画面，保持深色底，避免默认夜间主题闪白 -->
    <style name="Theme.DreamTales" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:windowSplashScreenBackground">@color/background_dark</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:navigationBarColor">@color/background_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.DreamTales.Launch" parent="Theme.DreamTales">
        <item name="android:windowDisablePreview">true</item>
    </style>
</resources>
